---
import Layout from "@/layouts/Layout.astro";
import PaintPicker from "@/components/paints/PaintPicker";
---

<Layout title="Add Paints">
  <div class="bg-cosmic min-h-screen p-4 py-10">
    <div class="mx-auto max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-1 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Add Paints
      </h1>
      <p class="mb-6 text-sm text-blue-100/60">Search the catalog and add the paints you own.</p>
      <PaintPicker client:load />
      <a href="/dashboard" class="mt-6 inline-block text-sm text-blue-100/60 hover:text-white">← Back to dashboard</a>
    </div>
  </div>
</Layout>
